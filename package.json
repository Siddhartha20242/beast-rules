{
  "name": "beast-rules",
  "description": "A Twitch overlay where chat writes stream rules that become a shared evolving beast.",
  "version": "0.1.0",
  "license": "MIT",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc -p tsconfig.json",
    "test": "vitest run",
    "eval": "node --import tsx scripts/eval.ts",
    "sandbox": "node --import tsx src/server.ts",
    "twitch:auth": "node --import tsx src/twitch/auth.ts",
    "lint": "eslint .",
    "demo": "node --import tsx scripts/demo.ts"
  },
  "dependencies": {
    "@twurple/api": "^8.2.0",
    "@twurple/auth": "^8.2.0",
    "@twurple/eventsub-ws": "^8.2.0",
    "ajv": "^8.17.1",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "obs-websocket-js": "^5.0.8",
    "ws": "^8.18.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.19.0",
    "@types/express": "^5.0.0",
    "@types/node": "^22.13.4",
    "@types/ws": "^8.5.14",
    "eslint": "^9.19.0",
    "globals": "^15.14.0",
    "tsx": "^4.19.3",
    "typescript": "^5.7.3",
    "typescript-eslint": "^8.24.0",
    "vitest": "^3.0.5"
  }
}
